{
  "name": "taiji-rehab-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:pose": "node scripts/copy-pose-assets.mjs && node scripts/prepare-pose.mjs",
    "dev": "pnpm prepare:pose && next dev --hostname 0.0.0.0",
    "build": "pnpm prepare:pose && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.real.config.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
